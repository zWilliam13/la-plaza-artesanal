generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Location {
  id     String  @id
  name   String
  tables Table[]
}

model Table {
  id           String        @id @default(cuid())
  locationId   String
  location     Location      @relation(fields: [locationId], references: [id])
  zone         String
  number       Int
  capacity     Int
  reservations Reservation[]

  @@unique([locationId, zone, number])
}

model Reservation {
  id            String   @id @default(cuid())
  tableId       String
  table         Table    @relation(fields: [tableId], references: [id])
  date          String   // "YYYY-MM-DD"
  time          String   // "20:30"
  partySize     Int
  customerName  String
  customerPhone String
  createdAt     DateTime @default(now())

  // The line that makes double-booking impossible at the DB level,
  // not just in application logic: two reservations can't share table+date+time.
  @@unique([tableId, date, time])
}
